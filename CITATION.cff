        given-names: Ethan
      - family-names: Campbell
        given-names: Evan
      - family-names: Phinyomark
        given-names: Angkoon
      - family-names: Bateman
        given-names: Scott
      - family-names: Scheme
        given-names: Erik
    journal: "IEEE Access"
    volume: 11
    year: 2023
    doi: "10.1109/ACCESS.2023.3304544"
